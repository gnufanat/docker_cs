[301.79796, "o", "\u001b[30m\u001b[46m/home/hl~ers.ini   [----]  0 L:[  1+ 0   1/ 55] *(0   /195[*][X]\u001b[2;1H\u001b[33m\u001b[44m; Users configuration file\u001b[37m\u001b[K\r\n\u001b[33m; File location: $moddir/addons/amxmodx/configs/users.ini\u001b[37m\u001b[K\r\n\u001b[K\n\u001b[33m; Line starting with ; is a comment\u001b[37m\u001b[K\r\n\u001b[K\n\u001b[33m; Access flags:\u001b[37m\u001b[K\r\n\u001b[33m; a - immunity (can't be kicked/banned/slayed/slapped and affect\u001b[9;1H; b - reservation (can join on reserved slots)\u001b[37m\u001b[K\r\n\u001b[33m; c - amx_kick command\u001b[37m\u001b[K\r\n\u001b[33m; d - amx_ban and amx_unban commands (permanent and temporary ba\u001b[12;1H; e - amx_slay and amx_slap commands\u001b[37m\u001b[K\r\n\u001b[33m; f - amx_map command\u001b[37m\u001b[K\r\n\u001b[33m; g - amx_cvar command (not all cvars will be available)\u001b[37m\u001b[K\r\n\u001b[33m; h - amx_cfg command\u001b[37m\u001b[K\r\n\u001b[33m; i - amx_chat and other chat commands\u001b[37m\u001b[K\r\n\u001b[33m; j - amx_vote and other vote commands\u001b[37m\u001b[K\r\n\u001b[33m; k - access to sv_password cvar (by amx_cvar command)\u001b[37m\u001b[K\r\n\u001b[33m; l - access to amx_rcon command and rcon_password cvar (by amx_\u001b[20;1H; m - custom level A (for additional plugins)\u001b[37m\u001b[K\r"]
[301.797993, "o", "\n\u001b[33m; n - custom level B\u001b[37m\u001b[K\r\n\u001b[33m; o - custom level C\u001b[37m\u001b[K\r\n\u001b[33m; p - custom level D\u001b[37m\u001b[K\r\n\u001b[33m; q - custom level E\u001b[37m\u001b[K\r\n\u001b[33m; r - custom level F\u001b[37m\u001b[K\r\n\u001b[33m; s - custom level G\u001b[37m\u001b[K\r\n\u001b[33m; t - custom level H\u001b[37m\u001b[K\r\n\u001b[33m; u - menu access\u001b[37m\u001b[K\r\n\u001b[33m; v - amx_ban and amx_unban commands (temporary bans only, about\u001b[30;1H; z - user (no admin)\u001b[37m\u001b[K\r\n\u001b[K\n\u001b[33m; Account flags:\u001b[37m\u001b[K\r\n\u001b[97m\u001b[40m 1\u001b[30m\u001b[46mПо~щь\u001b[97m\u001b[40m 2\u001b[30m\u001b[46mСо~ть\u001b[97m\u001b[40m 3\u001b[30m\u001b[46mБлок \u001b[97m\u001b[40m 4\u001b[30m\u001b[46mЗа~на\u001b[97m\u001b[40m 5\u001b[30m\u001b[46mКопия\u001b[97m\u001b[40m 6\u001b[30m\u001b[46mПе~ть\u001b[97m\u001b[40m 7\u001b[30m\u001b[46mПоиск\u001b[97m\u001b[40m 8\u001b[30m\u001b[46mУд~ть\u001b[97m\u001b[40m 9\u001b[30m\u001b[46mМе~MC\u001b[2;1H"]
[302.746585, "o", "\u001b[39m\u001b[49m\u001b[3;32r\u001b[3;1H\u001b[2M\u001b[1;33r\u001b[1;35H\u001b[30m\u001b[46m3\u001b[6C3\u001b[8C85\r\n\u001b[37m\u001b[44m\u001b[K\u001b[31;1H\u001b[33m; a - disconnect player on invalid password\u001b[37m\u001b[K\r\n\u001b[33m; b - clan tag\u001b[37m\u001b[K\u001b[2;1H"]
[302.786547, "o", "\u001b[39m\u001b[49m\u001b[3;32r\u001b[3;1H\u001b[2M\u001b[1;33r\u001b[1;35H\u001b[30m\u001b[46m5\u001b[6C5\u001b[8C122\u001b[31;1H\u001b[33m\u001b[44m; c - this is steamid/wonid\u001b[37m\u001b[K\r\n\u001b[33m; d - this is ip\u001b[37m\u001b[K\u001b[2;1H"]
[302.810244, "o", "\u001b[39m\u001b[49m\u001b[2;32r\u001b[2;1H\u001b[2M\u001b[1;33r\u001b[1;35H\u001b[30m\u001b[46m7\u001b[6C7\u001b[9C39\u001b[31;1H\u001b[33m\u001b[44m; e - password is not checked (only name/ip/steamid needed)\u001b[37m\u001b[K\r\n\u001b[33m; k - name or tag is case sensitive.  eg: if you set it so the n\u001b[2;1H"]
[302.86653, "o", "\u001b[39m\u001b[49m\u001b[2;32r\u001b[2;1H\u001b[2M\u001b[1;33r\u001b[1;35H\u001b[30m\u001b[46m9\u001b[6C9\u001b[8C273\u001b[31;1H\u001b[33m\u001b[44m;     is protected and case sensitive (flags \"k\" only), then any\u001b[32;1H;     can use the names \"haM\", \"HAM\", \"ham\", etc, but not \"Ham\"\u001b[37m\u001b[K\u001b[2;1H"]
[303.242853, "o", "\u001b[39m\u001b[49m\u001b[2;32r\u001b[2;1H\u001b[2M\u001b[1;33r\u001b[1;34H\u001b[30m\u001b[46m11\u001b[5C11\u001b[8C364\u001b[31;1H\u001b[37m\u001b[44m\u001b[K\n\u001b[33m; Password:\u001b[37m\u001b[K\u001b[2;1H"]
