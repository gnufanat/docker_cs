[51.574063, "o", "\u001b[7mIP=$(hostname -I | awk '{print $1}') && \u001b[27m\u001b[7mg\u001b[27m\u001b[7mrep -q '^SERVER_IP=' .env 2>/dev/null && sed -i \"s/^SERVER_IP=.\u001b[27m\u001b[7m*\u001b[27m\u001b[7m/SERVER_IP=$IP/\" .env || echo \"SERVER_IP=$IP\" >> .env && grep -\u001b[27m\u001b[7mq\u001b[27m\u001b[7m '^sv_downloadurl' server.cfg 2>/dev/null && sed -i \"s|^sv_down\u001b[27m\u001b[7ml\u001b[27m\u001b[7moadurl.*|sv_downloadurl \\\"http://$IP:8283/cstrike/\\\"|\" server.c\u001b[27m\u001b[7mf\u001b[27m\u001b[7mg || echo \"sv_downloadurl \\\"http://$IP:8283/cstrike/\\\"\" >> serv\u001b[27m\u001b[7me\u001b[27m\u001b[7mr.cfg\u001b[27m"]
